rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function roomDoc(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function memberDoc(roomId, uid) {
      return get(/databases/$(database)/documents/rooms/$(roomId)/members/$(uid)).data;
    }

    function isRoomHost(roomId) {
      return isSignedIn()
        && roomDoc(roomId).hostUserId == request.auth.uid;
    }

    function isRoomMember(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    function memberRole(roomId) {
      return memberDoc(roomId, request.auth.uid).role;
    }

    // Host always controls playback; controllers are explicitly promoted.
    function canIssuePlaybackCommand(roomId) {
      return isRoomHost(roomId)
        || (isRoomMember(roomId) && memberRole(roomId) == 'controller');
    }

    function isValidPlaybackCommand(command) {
      return command is map
        && command.keys().hasOnly(['id', 'type', 'issuedBy', 'issuedAt'])
        && command.id is string
        && command.id.size() > 0
        && command.type in ['play', 'pause', 'next', 'skip', 'restart']
        && command.issuedBy == request.auth.uid
        && command.issuedAt is string;
    }

    function onlyPlaybackCommandChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['playbackCommand', 'updatedAt']);
    }

    match /rooms/{roomId} {
      // Host creates the room with themselves as the first member (count = 1).
      allow create: if isSignedIn()
        && request.resource.data.hostUserId == request.auth.uid
        && request.resource.data.roomCode is string
        && request.resource.data.status in ['waiting', 'active']
        && request.resource.data.memberCount == 1;

      // Signed-in users can look up rooms by code / id.
      allow read: if isSignedIn();

      // Host controls all room fields. Controllers may only issue playback commands.
      allow update: if isRoomHost(roomId)
        || (
          canIssuePlaybackCommand(roomId)
          && onlyPlaybackCommandChanged()
          && isValidPlaybackCommand(request.resource.data.playbackCommand)
        );
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isSignedIn();

        // Only the host may create their own member doc from the client (room create).
        // Guest membership is created by the trusted joinRoom Cloud Function (Admin SDK).
        allow create: if isSignedIn()
          && request.auth.uid == memberId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.role == 'host';

        // Host may promote/demote guests <-> controllers. Host role is immutable.
        // Users cannot grant themselves controller permission.
        allow update: if isRoomHost(roomId)
          && resource.data.role in ['guest', 'controller']
          && request.resource.data.role in ['guest', 'controller']
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);

        allow delete: if isRoomHost(roomId)
          && resource.data.role != 'host';
      }

      match /queue/{queueItemId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && isRoomMember(roomId)
          && request.resource.data.singerUserId == request.auth.uid
          && request.resource.data.status == 'queued';

        // Queue advance / remove remains host-only. Controllers send playback
        // commands; the host player device applies next/skip against the queue.
        allow update: if isRoomHost(roomId)
          || (
            isRoomMember(roomId)
            && resource.data.singerUserId == request.auth.uid
            && request.resource.data.status == 'removed'
            && request.resource.data.singerUserId == resource.data.singerUserId
          );

        allow delete: if false;
      }
    }

    // Shared karaoke catalog — readable by signed-in users.
    // Trusted fields (usageCount, source, timestamps, availability) are written
    // only by Cloud Functions via the Admin SDK (upsertCatalogSongCallable).
    match /songs/{songId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Personal song bookmarks — private to the signed-in owner.
    match /users/{userId} {
      allow read, write: if false;

      match /savedSongs/{videoId} {
        allow read, delete: if isSignedIn() && request.auth.uid == userId;

        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.videoId == videoId
          && request.resource.data.title is string
          && request.resource.data.thumbnailUrl is string;
      }
    }
  }
}
